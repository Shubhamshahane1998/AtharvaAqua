{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker in Cloudflare. Without this file CI generated one on
  // the fly and took the self-reference name from package.json ("website"),
  // which is not a Worker that exists — deploys failed with code 10143.
  "name": "atharvaquaa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Workers Assets defaults to stripping ".html" with a 307, which broke the
    // Search Console verification file: Google fetches that exact URL and does
    // not reliably follow redirects. Pages are rendered by the worker, not
    // served from here, so exact matching costs nothing.
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atharvaquaa"
    }
  ],
  "observability": {
    "enabled": true
  }
}
